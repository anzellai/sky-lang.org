module Update exposing
    ( handleNavigate
    , selfDispatch
    , flashError
    , flashSuccess
    , slugify
    )

-- | Update — the PURE dispatch helpers for the TEA cycle.
--
-- `update` itself lives in `Main` (the entry module) because the
-- Sky.Spa auto-split's per-branch RPC rewrite reads `update`'s
-- `case msg of` from the entry file. This module holds only the
-- CLIENT-PURE helpers `update` calls: navigation, flash, slug
-- normalisation. The SERVER-tainted write/read helpers
-- (`handleSave`/`handleDelete`/`reloadPosts`/`loadEditPost`/
-- `goToAdminHome`) live in the backend-only `Server.Actions`
-- module; `update`'s server branches call them and the split turns
-- those branches into RPCs.
--
-- Nothing here forces an effect (`Task.run`) or touches `db`, so
-- the split classifies this module as PURE and copies it verbatim
-- into BOTH the wasm frontend and the native backend trees.

import Sky.Core.Prelude exposing (..)
import Sky.Core.String as String
import Sky.Core.Task as Task
import Std.Cmd as Cmd
import State exposing (..)


-- | `selfDispatch msg` — a client-safe command that delivers `msg`
-- back to `update` on the next tick. Built from `Task.succeed`
-- (pure), so navigation stays client-pure while a follow-up SERVER
-- branch (`LoadPosts` / `LoadEditPost`) does the actual DB read as
-- an RPC on the SPA path (and synchronously on the Live path).
selfDispatch : Msg -> Cmd Msg
selfDispatch msg =
    Cmd.perform (Task.succeed ()) (\_ -> msg)


-- ─── Navigation (PURE — client-safe) ───────────────────────────────
-- Sets the target page from the already-loaded model, then, for the
-- pages that need fresh server data, self-dispatches a SERVER branch
-- to load it. Client-side navigation itself never reads the DB, so
-- the split keeps the `Navigate` branch on the client.
handleNavigate : Page -> Model -> ( Model, Cmd Msg )
handleNavigate page model =
    case page of

        BlogIndex ->
            ( { model | page = page, flash = emptyFlash }
            , selfDispatch LoadPosts
            )

        BlogPost slug ->
            -- Pure resolution from the already-loaded published list
            -- (init's GET-safe read populates `model.posts`; the SSR
            -- settle does so server-side for a crawler's first paint).
            ( { model | page = page
              , currentPost = postBySlug slug model.posts
              , flash = emptyFlash
              }
            , Cmd.none
            )

        AdminHome ->
            ( { model | page = page, flash = emptyFlash }
            , selfDispatch LoadPosts
            )

        AdminNewPost ->
            ( { model | page = page
              , editorTitle = ""
              , editorSlug = ""
              , editorSummary = ""
              , editorBody = ""
              , editorMode = "new"
              , flash = emptyFlash
              }
            , Cmd.none
            )

        AdminEditPost slug ->
            -- Stash the target slug in `editorSlug` (a model field), then
            -- self-dispatch the NULLARY server `LoadEditPost`. The load
            -- reads `model.editorSlug` rather than taking a Msg arg —
            -- a whole-model-reading server branch that ALSO carried a Msg
            -- arg trips a spa-split backend-codegen limitation (see
            -- Server.Actions).
            ( { model | page = page
              , editorSlug = slug
              , editorMode = "edit"
              , flash = emptyFlash
              }
            , selfDispatch LoadEditPost
            )

        _ ->
            ( { model | page = page, flash = emptyFlash }, Cmd.none )


-- ─── Flash helpers ────────────────────────────────────────────────
flashError : String -> Flash
flashError m =
    { kind = "error", message = m }


flashSuccess : String -> Flash
flashSuccess m =
    { kind = "success", message = m }


-- ─── Slug normalisation ───────────────────────────────────────────
slugify : String -> String
slugify s =
    s |> String.trim |> String.toLower |> String.replace " " "-"
        |> stripNonSlugChars


-- Allow only [a-z0-9-]. Walk char-by-char; reject everything else.
stripNonSlugChars : String -> String
stripNonSlugChars s =
    stripNonSlugCharsLoop s 0 ""


stripNonSlugCharsLoop : String -> Int -> String -> String
stripNonSlugCharsLoop s i out =
    if i >= String.length s then
        out

    else
        let
            c = String.slice i (i + 1) s
            kept =
                if isSlugChar c then
                    c

                else
                    ""
        in
            stripNonSlugCharsLoop s (i + 1) (out ++ kept)


isSlugChar : String -> Bool
isSlugChar c =
    -- Pure-string allowlist: [a-z0-9-]. Avoids the `Char` rune
    -- path which currently mistypes through the lowerer.
    c == "-" || c == "0" || c == "1" || c == "2" || c == "3" || c == "4" || c
        == "5"
        || c
        == "6"
        || c
        == "7"
        || c
        == "8"
        || c
        == "9"
        || c
        == "a"
        || c
        == "b"
        || c
        == "c"
        || c
        == "d"
        || c
        == "e"
        || c
        == "f"
        || c
        == "g"
        || c
        == "h"
        || c
        == "i"
        || c
        == "j"
        || c
        == "k"
        || c
        == "l"
        || c
        == "m"
        || c
        == "n"
        || c
        == "o"
        || c
        == "p"
        || c
        == "q"
        || c
        == "r"
        || c
        == "s"
        || c
        == "t"
        || c
        == "u"
        || c
        == "v"
        || c
        == "w"
        || c
        == "x"
        || c
        == "y"
        || c
        == "z"
