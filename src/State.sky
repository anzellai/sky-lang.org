module State exposing
    ( Model
    , Msg(..)
    , Page(..)
    , Session
    , Post
    , Flash
    , emptySession
    , emptyPost
    , emptyFlash
    , rowToPost
    , postBySlug
    , publishedSql
    , postCodec
    , flashCodec
    , sessionCodec
    , pageCodec
    )

-- | Application state for sky-lang.org.
--
-- Page constructors with a `String` slot carry URL-captured
-- parameters (`route "/blog/:slug/" (BlogPost "")` — the runtime
-- fills the slot with the matched slug). See `Routes.sky`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Dict as Dict
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Error exposing (Error)
import Std.Codec as Codec exposing (Codec)

-- ─── Pages ────────────────────────────────────────────────────────
type Page
    = HomePage
    | BlogIndex
    | BlogPost String
    | AdminLoginPage
    | AdminHome
    | AdminNewPost
    | AdminEditPost String
    | NotFoundPage

-- ─── Session + posts ──────────────────────────────────────────────
type alias Session =
    { githubLogin : String
    , githubId : Int
    , tokenId : String
    , expiresAt : Int
    }


emptySession : Session
emptySession =
    { githubLogin = "", githubId = 0, tokenId = "", expiresAt = 0 }

type alias Post =
    { id : Int
    , slug : String
    , title : String
    , summary : String
    , bodyMd : String
    , bodyHtml : String
    , authorGithubLogin : String
    , publishedAt : Int
    , createdAt : Int
    , updatedAt : Int
    , isPublished : Bool
    }


emptyPost : Post
emptyPost =
    { id = 0
    , slug = ""
    , title = ""
    , summary = ""
    , bodyMd = ""
    , bodyHtml = ""
    , authorGithubLogin = ""
    , publishedAt = 0
    , createdAt = 0
    , updatedAt = 0
    , isPublished = False
    }

type alias Flash =
    { kind : String
    , message : String
    }


emptyFlash : Flash
emptyFlash =
    { kind = "", message = "" }

-- ─── Model ────────────────────────────────────────────────────────
type alias Model =
    { page : Page
    , session : Maybe Session
    , posts : List Post
    , currentPost : Maybe Post
    , flash : Flash
    , editorTitle : String
    , editorSlug : String
    , editorSummary : String
    , editorBody : String
    , editorMode : String
    }

-- ─── Msg ──────────────────────────────────────────────────────────
type Msg
    = Navigate Page
    | LoadPosts
    | LoadEditPost
    | ConfirmDelete
    | GotPosts (Result Error (List (Dict String String)))
    | DismissFlash
    | EditorTitle String
    | EditorSlug String
    | EditorSummary String
    | EditorBody String
    | EditorSaveDraft
    | EditorPublish
    | EditorDelete String
    | NoOp
    -- Deferred result of `init`'s GET-safe `Db.query` (Sky.Spa SSR):
    -- the SSR settle runs this server-side and embeds the resolved
    -- model; the wasm client re-issues it as an RPC.


-- | The published-posts SELECT (PURE `String` constant). Lives here
-- in the shared pure module so BOTH `Model.init`'s GET-safe deferred
-- read (`Cmd.perform (Db.query db publishedSql [])`, carried into the
-- wasm frontend) and the backend-only `Db.Posts.listPublished` helper
-- can reference it. It cannot live in `Db.Posts` — that module is
-- server-tainted and routed backend-only, so the frontend-retained
-- `init` could not reach a constant defined there.
publishedSql : String
publishedSql =
    """
    SELECT id, slug, title, summary, body_md, body_html,
           author_github_login,
           COALESCE(published_at, 0) AS published_at,
           created_at, updated_at,
           CASE WHEN published_at IS NULL THEN 0 ELSE 1 END AS is_published
    FROM posts
    WHERE deleted_at IS NULL AND published_at IS NOT NULL
    ORDER BY published_at DESC
    """


-- ─── Row → typed record (PURE — client-safe) ──────────────────────
-- Moved here from Db.Posts so both the client decode branch
-- (`GotPosts`) and the server helpers share ONE pure lifter. Db.Posts
-- is server-tainted (it holds `db`-backed reads/writes) and is routed
-- backend-only by the Sky.Spa split, so a pure lifter living there
-- could not be referenced from the client tree.
rowToPost : Dict String String -> Post
rowToPost row =
    { emptyPost | id = dictInt "id" row
    , slug = dictGet "slug" row
    , title = dictGet "title" row
    , summary = dictGet "summary" row
    , bodyMd = dictGet "body_md" row
    , bodyHtml = dictGet "body_html" row
    , authorGithubLogin = dictGet "author_github_login" row
    , publishedAt = dictInt "published_at" row
    , createdAt = dictInt "created_at" row
    , updatedAt = dictInt "updated_at" row
    , isPublished = dictInt "is_published" row == 1
    }


dictGet : String -> Dict String String -> String
dictGet key row =
    case Dict.get key row of

        Just v ->
            v

        Nothing ->
            ""


dictInt : String -> Dict String String -> Int
dictInt key row =
    case String.toInt (dictGet key row) of

        Just n ->
            n

        Nothing ->
            0


-- | `postBySlug slug posts` — resolve a post from the already-loaded
-- model list (PURE). Replaces the synchronous `Posts.getBySlug` DB
-- read that used to live in `view` / `headFor`; on the Sky.Spa path
-- `view` must be pure, so the post body is resolved from the model
-- the SSR settle (or the client RPC) populated in `init`.
postBySlug : String -> List Post -> Maybe Post
postBySlug slug posts =
    List.head (List.filter (\p -> p.slug == slug) posts)


-- | `postCodec` — record↔JSON codec for `Post`. Lives in this shared
-- PURE module so the Sky.Spa auto-split can copy it into `Shared` and
-- wire the RPC fields that carry a `Post` (`posts : List Post`,
-- `currentPost : Maybe Post`) between the wasm client and the backend.
-- Field order MUST match the `Post` record declaration above.
postCodec : Codec Post
postCodec =
    Codec.object Post |> Codec.field "id" .id Codec.int
        |> Codec.field "slug" .slug Codec.string
        |> Codec.field "title" .title Codec.string
        |> Codec.field "summary" .summary Codec.string
        |> Codec.field "bodyMd" .bodyMd Codec.string
        |> Codec.field "bodyHtml" .bodyHtml Codec.string
        |> Codec.field "authorGithubLogin" .authorGithubLogin Codec.string
        |> Codec.field "publishedAt" .publishedAt Codec.int
        |> Codec.field "createdAt" .createdAt Codec.int
        |> Codec.field "updatedAt" .updatedAt Codec.int
        |> Codec.field "isPublished" .isPublished Codec.bool
        |> Codec.buildObject


-- | `flashCodec` — record↔JSON codec for `Flash`, for the RPC wire
-- fields that carry `flash : Flash`. Field order matches `Flash`.
flashCodec : Codec Flash
flashCodec =
    Codec.object Flash |> Codec.field "kind" .kind Codec.string
        |> Codec.field "message" .message Codec.string
        |> Codec.buildObject


-- | `sessionCodec` — record↔JSON codec for `Session`, for the RPC
-- wire fields that carry `session : Maybe Session`. Field order
-- matches `Session`.
sessionCodec : Codec Session
sessionCodec =
    Codec.object Session |> Codec.field "githubLogin" .githubLogin Codec.string
        |> Codec.field "githubId" .githubId Codec.int
        |> Codec.field "tokenId" .tokenId Codec.string
        |> Codec.field "expiresAt" .expiresAt Codec.int
        |> Codec.buildObject


-- | `pageCodec` — tagged-union codec for the `Page` ADT, for the RPC
-- wire fields that carry `page : Page` (a server branch that resets
-- the page, e.g. the editor writes → `AdminHome`, must serialise it).
-- Encodes as `["Tag", arg…]`; the two parameterised pages carry their
-- captured slug `String`.
pageCodec : Codec Page
pageCodec =
    Codec.taggedUnion
        (\v ->
            case v of

                HomePage ->
                    ( "HomePage", [] )

                BlogIndex ->
                    ( "BlogIndex", [] )

                BlogPost slug ->
                    ( "BlogPost", [ Codec.toValue Codec.string slug ] )

                AdminLoginPage ->
                    ( "AdminLoginPage", [] )

                AdminHome ->
                    ( "AdminHome", [] )

                AdminNewPost ->
                    ( "AdminNewPost", [] )

                AdminEditPost slug ->
                    ( "AdminEditPost", [ Codec.toValue Codec.string slug ] )

                NotFoundPage ->
                    ( "NotFoundPage", [] ))
        [ Codec.var0 "HomePage" HomePage
        , Codec.var0 "BlogIndex" BlogIndex
        , Codec.var1 "BlogPost" BlogPost Codec.string
        , Codec.var0 "AdminLoginPage" AdminLoginPage
        , Codec.var0 "AdminHome" AdminHome
        , Codec.var0 "AdminNewPost" AdminNewPost
        , Codec.var1 "AdminEditPost" AdminEditPost Codec.string
        , Codec.var0 "NotFoundPage" NotFoundPage
        ]
