module Seed exposing (syncFromDisk)

-- | Content sync from disk. Git `.md` is the source of truth.
--
-- On every boot, read every `content/posts/*.md`, parse the YAML
-- frontmatter, render the body to HTML, and reconcile it into the
-- `posts` table: a new slug is inserted + published; an existing slug
-- whose disk content has changed is UPDATED in place (title/summary/
-- body/html); an unchanged slug is skipped (idempotent). Commit an
-- edit to a post's `.md`, redeploy, and it goes live.
--
-- Policy: git wins for any post that exists on disk, so an admin-UI
-- edit to an on-disk post does not survive the next redeploy (edit the
-- `.md` instead). Admin-authored posts with NO `.md` file are never
-- touched by the sync.
--
-- The content directory is read relative to the process CWD (the
-- systemd unit sets WorkingDirectory; in dev it's the repo root).
-- A missing directory is non-fatal (logged at info, then we proceed
-- without syncing) so the app boots cleanly even before the content/
-- dir is shipped to a fresh server.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.File as File
import Sky.Core.List as List
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Db.Posts as Posts
import Markdown
import Std.Log exposing (println)


syncFromDisk : () -> Task Error ()
syncFromDisk _ =
    case Posts.listAll () of

        Err e ->
            let
                _ =
                    println
                        ("[SEED] could not read posts table — skipping sync: "
                            ++ Error.toString e)
            in
                Task.succeed ()

        Ok _ ->
            -- Reconcile every content/posts/*.md into the table: insert new
            -- slugs, update changed ones from disk, skip unchanged (below).
            seedFromDisk ()


seedFromDisk : () -> Task Error ()
seedFromDisk _ =
    File.readDir "content/posts"
        |> Task.onError
               (\e ->
                   let
                       _ =
                           println
                               ("[SEED] content/posts not readable: "
                                   ++ Error.toString e
                                   ++ " — skipping seed")
                   in
                       Task.succeed [])
        |> Task.andThen
               (\names ->
                   let
                       mdNames = List.filter isMarkdown names
                       _ =
                           println
                               ("[SEED] found "
                                   ++ String.fromInt (countList mdNames)
                                   ++ " markdown files in content/posts")
                   in
                       seedAll mdNames)


seedAll : List String -> Task Error ()
seedAll names =
    case names of

        [] ->
            Task.succeed ()

        name :: rest ->
            seedOne name |> Task.andThen (\_ -> seedAll rest)


seedOne : String -> Task Error ()
seedOne name =
    let
        path = "content/posts/" ++ name
    in
        File.readFile path
            |> Task.andThen
                   (\raw ->
                       case parseFrontmatter raw of

                           Just parsed ->
                               insertSeeded parsed

                           Nothing ->
                               let
                                   _ =
                                       println
                                           ("[SEED] " ++ path
                                               ++ " has no frontmatter — skipping")
                               in
                                   Task.succeed ())


insertSeeded : ParsedPost -> Task Error ()
insertSeeded p =
    case Posts.getBySlug p.slug of

        Ok (Just existing) ->
            -- Post exists. Git `.md` is the source of truth: if the disk content
            -- differs from the DB, overwrite title/summary/body (+ re-rendered
            -- HTML) in place. Publish state is left untouched. If it matches,
            -- skip so boots stay idempotent. NOTE: this means an admin-UI edit to
            -- a post that also exists on disk does NOT survive the next redeploy —
            -- that is the chosen policy (edit the `.md` and redeploy to publish a
            -- change). Admin-authored posts with no `.md` file are never touched.
            if existing.title == p.title && existing.summary == p.summary
                && existing.bodyMd
                == p.body then
                let
                    _ = println ("[SEED] up to date, skipping " ++ p.slug)
                in
                    Task.succeed ()

            else
                updateFromDisk p

        _ ->
            insertNew p


updateFromDisk : ParsedPost -> Task Error ()
updateFromDisk p =
    Time.unixMillis ()
        |> Task.andThen
               (\nowMs ->
                   let
                       html = Markdown.render p.body
                       result =
                           Posts.update
                               p.slug
                               p.title
                               p.summary
                               p.body
                               html
                               nowMs
                   in
                       case result of

                           Ok _ ->
                               let
                                   _ =
                                       println
                                           ("[SEED] updated from disk " ++ p.slug)
                               in
                                   Task.succeed ()

                           Err e ->
                               Task.fail e)


insertNew : ParsedPost -> Task Error ()
insertNew p =
    Time.unixMillis ()
        |> Task.andThen
               (\nowMs ->
                   let
                       publishedAtMs = nowMs
                       html = Markdown.render p.body
                       result =
                           Posts.create
                               p.slug
                               p.title
                               p.summary
                               p.body
                               html
                               p.author
                               nowMs
                   in
                       case result of

                           Ok _ ->
                               -- Now publish so the post appears on /blog/.
                               case Posts.publish p.slug publishedAtMs of

                                   Ok _ ->
                                       let
                                           _ =
                                               println
                                                   ("[SEED] inserted + published "
                                                       ++ p.slug)
                                       in
                                           Task.succeed ()

                                   Err e ->
                                       Task.fail e

                           Err e ->
                               Task.fail e)

-- ─── Frontmatter parser ───────────────────────────────────────────
type alias ParsedPost =
    { title : String
    , slug : String
    , author : String
    , summary : String
    , body : String
    }


-- A frontmatter block looks like:
--
--   ---
--   title: Foo
--   slug: foo
--   ...
--   ---
--
--   # Body...
--
-- We parse it line-oriented — simpler than threading a YAML
-- library through the FFI for ≤10 keys.
parseFrontmatter : String -> Maybe ParsedPost
parseFrontmatter raw =
    case String.lines raw of

        firstLine :: rest ->
            if String.trim firstLine == "---" then
                consumeFrontmatter rest [] ""

            else
                Nothing

        [] ->
            Nothing


consumeFrontmatter : List String -> List ( String, String ) -> String -> Maybe ParsedPost
consumeFrontmatter lines acc _ =
    case lines of

        [] ->
            Nothing

        line :: rest ->
            if String.trim line == "---" then
                Just (buildParsed (List.reverse acc) (String.join "\n" rest))

            else
                case parseKeyValue line of

                    Just kv ->
                        consumeFrontmatter rest (kv :: acc) ""

                    Nothing ->
                        consumeFrontmatter rest acc ""


parseKeyValue : String -> Maybe ( String, String )
parseKeyValue line =
    case findColon line 0 of

        Just idx ->
            let
                key = String.trim (String.slice 0 idx line)
                val =
                    String.trim
                        (String.slice (idx + 1) (String.length line) line)
            in
                Just ( key, stripQuotes val )

        Nothing ->
            Nothing


findColon : String -> Int -> Maybe Int
findColon s i =
    if i >= String.length s then
        Nothing

    else if String.slice i (i + 1) s == ":" then
        Just i

    else
        findColon s (i + 1)


stripQuotes : String -> String
stripQuotes v =
    if String.startsWith "\"" v && String.endsWith "\"" v && String.length v >= 2 then
        String.slice 1 (String.length v - 1) v

    else
        v


buildParsed : List ( String, String ) -> String -> ParsedPost
buildParsed keys body =
    { title = lookup "title" keys
    , slug = lookup "slug" keys
    , author = lookup "author" keys
    , summary = lookup "summary" keys
    , body = String.trim body
    }


lookup : String -> List ( String, String ) -> String
lookup key xs =
    case xs of

        [] ->
            ""

        ( k, v ) :: rest ->
            if k == key then
                v

            else
                lookup key rest


-- ─── Helpers ──────────────────────────────────────────────────────
isMarkdown : String -> Bool
isMarkdown name =
    String.endsWith ".md" name


countList : List a -> Int
countList xs =
    countListHelp xs 0


countListHelp : List a -> Int -> Int
countListHelp xs acc =
    case xs of

        [] ->
            acc

        _ :: rest ->
            countListHelp rest (acc + 1)
