module Auth.Console exposing (consoleAdmin, handleConsoleLink)

-- | Auth.Console — the Sky Console (/_sky/console) for the site's admins.
--
-- The deploy runs with `SKY_CONSOLE_AUTH=app`, and `Main` attaches
-- `App.withConsoleAuth consoleAdmin`. The runtime calls `consoleAdmin` for a
-- console request with no console session: a valid GitHub admin session
-- (the `sky_sid` cookie, verified by `Session.validateCookie` against its
-- signature, expiry and the `admin_sessions` row) whose login is on the
-- allowlist opens the console. Anyone else gets 403. There is no console
-- token to share.
--
-- `/admin/console-link` (the Admin page's "Console" link) sends a signed-in
-- admin to the console, and anyone else to the login page.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error
import Sky.Core.Maybe as Maybe
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Http.Server as Server
import Std.Live.Console as LiveConsole
import Auth.Allowlist as Allowlist
import Auth.Session as Session
import View.Response as Response


-- ─── SKY_CONSOLE_AUTH=app gate ────────────────────────────────────
-- The site's sign-in is its own cookie, so the check reads the request and
-- ignores the model.
consoleAdmin : Server.Request -> model -> Task Error.Error (Maybe LiveConsole.Identity)
consoleAdmin req _ =
    case adminLogin req of

        Just login ->
            Task.succeed
                (Just
                    (LiveConsole.defaultIdentity login
                        |> LiveConsole.withClaim "provider" "github"))

        Nothing ->
            Task.succeed Nothing


-- The GitHub login of a valid, allowlisted admin session, if any.
adminLogin : Server.Request -> Maybe String
adminLogin req =
    case Session.validateCookie
             (Maybe.withDefault "" (Server.getCookie Session.cookieName req)) of

        Just session ->
            if Allowlist.isAllowed session.githubLogin then
                Just session.githubLogin

            else
                Nothing

        Nothing ->
            Nothing


-- ─── /admin/console-link ──────────────────────────────────────────
handleConsoleLink : Server.Request -> Task Error.Error Server.Response
handleConsoleLink req =
    case adminLogin req of

        Just _ ->
            Task.succeed (Response.redirect "/_sky/console/")

        Nothing ->
            Task.succeed (Response.redirect "/admin/login?err=session")
