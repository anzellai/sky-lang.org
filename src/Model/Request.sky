module Model.Request exposing (applyRequest)

-- | `applyRequest req model` — the Std.App `withRequest` hook.
--
-- It sets `model.session` from the request's signed `skylang_admin` cookie
-- (`Auth.Admin.sessionFromRequest`: JWT signature + expiry + a live
-- `admin_sessions` row + the allowlist), and ALWAYS overwrites it: with no
-- valid cookie the session is `Nothing`, whatever the model held before.
--
-- Where it runs, and why that closes the forged-session hole:
--
-- * Sky.Spa (`--target web:app`, production): the split backend runs this
--   hook on the SSR of every page AND inside every generated `/_rpc/<Msg>`
--   handler, after it decodes the client's model fields from the request
--   body and before it calls `update`. So the `session` a client sends in
--   an RPC body is replaced by the server's own answer before any server
--   branch reads it.
-- * Sky.Live: it runs at session start with the HTTP request. The model
--   then lives on the server, so the client never supplies `session`.
--
-- The admin server branches (`Server.Actions`) ALSO re-check the session
-- (`Auth.Admin.requireAdmin`) before they read drafts or write posts.
--
-- This hook is SERVER-ONLY (a DB read), which is why it lives outside the
-- pure, client-shared modules.

import Sky.Core.Prelude exposing (..)
import Sky.Http.Server as Server
import Std.Cmd as Cmd
import State exposing (..)
import Msg exposing (..)
import Auth.Admin as Admin


applyRequest : Server.Request -> Model -> ( Model, Cmd Msg )
applyRequest req model =
    ( { model | session = Admin.sessionFromRequest req }, Cmd.none )
