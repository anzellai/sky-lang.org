module Server.Actions exposing (reloadPosts, loadEditPost, handleSave, handleDelete, goToAdminHome)

-- | Server.Actions — the SERVER-TAINTED write/read helpers for the
-- TEA cycle, factored OUT of `Update` so that `Update` stays a PURE
-- sibling module the Sky.Spa auto-split can copy into the wasm
-- frontend verbatim.
--
-- Every def here forces a synchronous `Task.run` of a `Db`/`Time`
-- effect, so the split classifies this whole module as backend-only
-- and NEVER emits it (or an import of it) into the frontend. The
-- `update` branches in `Main` that call these functions are the
-- SERVER branches — the split rewrites them into RPCs on the client
-- and reuses them verbatim on the backend. Mirrors the passing
-- `spa-split-multimodule` fixture's `Store` module.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Result as Result
import Sky.Core.String as String
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Std.Cmd as Cmd
import Std.Log exposing (println)
import State exposing (..)
import Msg exposing (..)
import Db.Posts as Posts
import Markdown
import Update exposing (flashError, flashSuccess)
import Auth.Admin as Admin
import Auth.Policy as Policy


-- ─── Authorisation (every admin branch) ─────────────────────────────
-- In the Sky.Spa build each server branch here is an unauthenticated-by-
-- default `/_rpc/<Msg>` endpoint that anyone can POST to. The model it
-- receives is rebuilt from the request body, except `session`, which
-- `Model.Request.applyRequest` has already replaced with the value the
-- signed `skylang_admin` cookie proves. Every ADMIN branch (the all-posts
-- list, the draft editor load, save, publish, delete) still re-checks it
-- through `Admin.requireAdmin` and, on `Nothing`, returns the model with a
-- "Sign in required." flash and performs no read of drafts and no write.
-- PUBLIC branches (the published-posts list for the blog index) need none.
-- The model an admin branch returns when the caller is not a signed-in
-- admin: unchanged apart from the flash. Nothing is written.
refuse : Model -> Model
refuse model =
    { model | flash = flashError Policy.signInRequired }


-- | `reloadPosts model` — refresh the post list for the current
-- page (published for the blog index, all for admin home). Server
-- helper (synchronous DB read); called from the `LoadPosts` branch.
reloadPosts : Model -> Model
reloadPosts model =
    case model.page of

        BlogIndex ->
            { model | posts = Result.withDefault [] (Posts.listPublished ()) }

        AdminHome ->
            -- ADMIN: the all-posts list includes drafts.
            case Admin.requireAdmin model.session of

                Just _ ->
                    { model | posts = Result.withDefault [] (Posts.listAll ()) }

                Nothing ->
                    { model | posts = [] }

        _ ->
            model


-- | `loadEditPost model` — load the post named by `model.editorSlug`
-- (stashed at Navigate time) and prefill the editor fields. Server
-- helper (synchronous DB read); called from the arg-less
-- `LoadEditPost` branch.
--
-- NOTE (spa-split codegen): this branch reads the whole model AND is
-- reached as an RPC. It is deliberately ARG-LESS. A server branch
-- that both reads the whole model and carries a Msg arg makes the
-- spa-split backend emit `m = p` (binding the request record `p` to
-- `Model`) followed by `(Ctor p.<arg>)`, which fails to type-check
-- because `p` is unified to `Model` and no longer has the arg field
-- (rust/crates/project/src/spa_split.rs:1741-1770). Carrying the slug
-- in `editorSlug` sidesteps it.
loadEditPost : Model -> Model
loadEditPost model =
    -- ADMIN: the editor loads drafts.
    case Admin.requireAdmin model.session of

        Just _ ->
            loadEditPostAuthorised model

        Nothing ->
            refuse model


loadEditPostAuthorised : Model -> Model
loadEditPostAuthorised model =
    case Result.withDefault Nothing (Posts.getBySlug model.editorSlug) of

        Just post ->
            { model | currentPost = Just post
            , editorTitle = post.title
            , editorSlug = post.slug
            , editorSummary = post.summary
            , editorBody = post.bodyMd
            , editorMode = "edit"
            }

        Nothing ->
            { model | page = AdminHome, flash = flashError "Post not found." }


-- ─── Editor save / publish / delete ────────────────────────────────
handleSave : Bool -> Model -> ( Model, Cmd Msg )
handleSave publishAfter model =
    -- ADMIN: create / update / publish a post.
    case Admin.requireAdmin model.session of

        Just login ->
            saveAs login publishAfter model

        Nothing ->
            ( refuse model, Cmd.none )


-- `saveAs login publishAfter model` — the save, once `login` is a verified
-- admin. The author recorded on a new post is that verified login, never a
-- value from the client.
saveAs : String -> Bool -> Model -> ( Model, Cmd Msg )
saveAs authorLogin publishAfter model =
    if String.trim model.editorTitle == "" then
        ( { model | flash = flashError "Title is required." }, Cmd.none )

    else if String.trim model.editorSlug == "" then
        ( { model | flash = flashError "Slug is required." }, Cmd.none )

    else
        let
            html = Markdown.render model.editorBody
            nowMs = Result.withDefault 0 (Task.run (Time.unixMillis ()))
            writeResult =
                case model.editorMode of

                    "edit" ->
                        Posts.update
                            model.editorSlug
                            model.editorTitle
                            model.editorSummary
                            model.editorBody
                            html
                            nowMs

                    _ ->
                        Posts.create
                            model.editorSlug
                            model.editorTitle
                            model.editorSummary
                            model.editorBody
                            html
                            authorLogin
                            nowMs
        in
            case writeResult of

                Err e ->
                    let
                        _ =
                            println
                                ("[POST WRITE] failed: " ++ Error.toString e)
                    in
                        ( { model | flash =
                              flashError ("Save failed: " ++ Error.toString e)
                          }
                        , Cmd.none
                        )

                Ok _ ->
                    if publishAfter then
                        case Posts.publish model.editorSlug nowMs of

                            Ok _ ->
                                ( goToAdminHome model "Published.", Cmd.none )

                            Err e ->
                                ( { model | flash =
                                      flashError
                                          ("Publish failed: " ++ Error.toString e)
                                  }
                                , Cmd.none
                                )

                    else
                        ( goToAdminHome model "Draft saved.", Cmd.none )


-- | `handleDelete model` — soft-delete the post named by
-- `model.editorSlug` (stashed by the client `EditorDelete` branch).
-- Arg-less for the same spa-split codegen reason as `loadEditPost`.
handleDelete : Model -> ( Model, Cmd Msg )
handleDelete model =
    -- ADMIN: soft-delete a post.
    case Admin.requireAdmin model.session of

        Just _ ->
            deleteAuthorised model

        Nothing ->
            ( refuse model, Cmd.none )


deleteAuthorised : Model -> ( Model, Cmd Msg )
deleteAuthorised model =
    let
        slug = model.editorSlug
        nowMs = Result.withDefault 0 (Task.run (Time.unixMillis ()))
    in
        case Posts.softDelete slug nowMs of

            Err e ->
                ( { model | flash = flashError ("Delete failed: " ++ Error.toString e)
                  }
                , Cmd.none
                )

            Ok _ ->
                ( goToAdminHome model ("Deleted " ++ slug ++ "."), Cmd.none )


goToAdminHome : Model -> String -> Model
goToAdminHome model msg =
    { model | page = AdminHome
    , posts = Result.withDefault [] (Posts.listAll ())
    , editorTitle = ""
    , editorSlug = ""
    , editorSummary = ""
    , editorBody = ""
    , flash = flashSuccess msg
    }
