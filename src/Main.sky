module Main exposing (main, config)

-- | sky-lang.org — the Sky Lang reference site.
--
-- Boot sequence:
--   1. Alias `SKYLANG_SESSION_SECRET` → `SKY_AUTH_TOKEN_SECRET`
--      so Std.Auth's framework reader finds it (Option A from
--      foundation/decisions.md).
--   2. Open the database via `Db.Conn` (embedded PostgreSQL — (top-level
--      binding — process exits cleanly if open fails).
--   3. Run schema migrations.
--   4. Seed the `posts` table from `content/posts/*.md` if empty.
--   5. Start the Sky.Live app on the port from `[live]` /
--      `SKY_LIVE_PORT`.
--
-- The TEA cycle dispatches Page navigation; OAuth + healthz +
-- robots + sitemap are `Live.api` routes outside the TEA cycle
-- (see `apiRoutes`).

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.System as System
import Sky.Core.Task as Task
import Std.App as App exposing (Config(..))
import Std.Cmd as Cmd
import Std.Log exposing (println)
import Std.Ui as Ui exposing (Element)
import View.Response as Resp
import State exposing (..)
import Model exposing (init)
import Model.Request as ModelRequest
import Update as U
import Server.Actions as Actions
import Subs exposing (subscriptions)
import Routes
import Db.Conn exposing (db)
import Db.Schema as Schema
import Seed
import Auth.Github as GhAuth
import Auth.DevLogin as DevLogin
import Auth.Session as Session
import Auth.Console as ConsoleAuth
import View.Common as C
import View.Home as Home
import View.Blog as Blog
import View.Admin as Admin
import View.AdminPost as AdminPost
import View.NotFound as NotFound
import View.Seo as Seo
import Sky.Config as Config exposing (LogFormat(..), LogLevel(..), Sessions(..))


-- ─── Update (TEA dispatch) ─────────────────────────────────────────
-- `update` lives HERE, in the entry module, because the Sky.Spa
-- auto-split reads its `case msg of` from the entry file to perform
-- the per-branch RPC rewrite. PURE branches (navigation, editor
-- field edits, decode) stay client-side; SERVER branches
-- (`LoadPosts` / `LoadEditPost` / editor writes) call the
-- backend-only `Server.Actions` helpers and the split turns them
-- into RPCs on the wasm client (running them verbatim server-side).
update : Msg -> Model -> ( Model, Cmd Msg )
update msg model =
    case msg of

        Navigate page ->
            U.handleNavigate page model

        LoadPosts ->
            ( Actions.reloadPosts model, Cmd.none )

        -- Nullary SERVER branch: loads the post named by `model.editorSlug`
        -- (set at Navigate time) and prefills the editor. Kept arg-less on
        -- purpose — see Server.Actions for the spa-split codegen reason.
        LoadEditPost ->
            ( Actions.loadEditPost model, Cmd.none )

        -- Nullary SERVER branch: deletes the post named by
        -- `model.editorSlug` (stashed by the client `EditorDelete` branch).
        ConfirmDelete ->
            Actions.handleDelete model

        -- Deferred result of `init`'s GET-safe published-posts read.
        -- Pure decode (client-safe): lift the raw rows into typed
        -- posts via the shared `State.rowToPost`. On the SSR path this
        -- is folded by `Spa_ssrSettle` server-side; on the client it
        -- runs after the RPC completes.
        GotPosts (Ok rows) ->
            ( { model | posts = List.map rowToPost rows }, Cmd.none )

        GotPosts (Err _) ->
            ( model, Cmd.none )

        DismissFlash ->
            ( { model | flash = emptyFlash }, Cmd.none )

        EditorTitle s ->
            ( { model | editorTitle = s }, Cmd.none )

        EditorSlug s ->
            ( { model | editorSlug = U.slugify s }, Cmd.none )

        EditorSummary s ->
            ( { model | editorSummary = s }, Cmd.none )

        EditorBody s ->
            ( { model | editorBody = s }, Cmd.none )

        EditorSaveDraft ->
            Actions.handleSave False model

        EditorPublish ->
            Actions.handleSave True model

        -- CLIENT branch (pure): stash the target slug in `editorSlug`,
        -- then self-dispatch the nullary SERVER `ConfirmDelete`. Keeping
        -- the DB write on an arg-less server branch dodges the spa-split
        -- whole-model-read + Msg-arg codegen limitation.
        EditorDelete slug ->
            ( { model | editorSlug = slug }, U.selfDispatch ConfirmDelete )

        NoOp ->
            ( model, Cmd.none )


-- ─── View dispatcher ───────────────────────────────────────────────
view : Model -> Element Msg
view model =
    C.pageShell model (pageBody model)


pageBody : Model -> Element Msg
pageBody model =
    case model.page of

        HomePage ->
            Home.view model

        BlogIndex ->
            Blog.viewIndex model

        BlogPost _ ->
            Blog.viewPost model

        AdminLoginPage ->
            Admin.viewLogin model

        AdminHome ->
            case model.session of

                Just _ ->
                    Admin.viewHome model

                Nothing ->
                    Admin.viewLogin model

        AdminNewPost ->
            case model.session of

                Just _ ->
                    AdminPost.view model

                Nothing ->
                    Admin.viewLogin model

        AdminEditPost _ ->
            case model.session of

                Just _ ->
                    AdminPost.view model

                Nothing ->
                    Admin.viewLogin model

        NotFoundPage ->
            NotFound.view model


-- ─── Bootstrap (top-level eager bindings) ──────────────────────────
-- Side-effecting top-level binding — referenced from main below
-- so the lowerer keeps + forces it. Aliases the session secret
-- and runs the schema + seed pipeline.
bootstrap : ()
bootstrap =
    let
        result =
            System.getenv "SKYLANG_SESSION_SECRET"
                |> Task.andThen
                       (\secret ->
                           if secret == "" then
                               let
                                   _ =
                                       println
                                           "[FATAL] SKYLANG_SESSION_SECRET is empty — refusing to start"
                               in
                                   Task.fail
                                       (Error.unexpected
                                           "SKYLANG_SESSION_SECRET must be set")

                           else
                               System.setenv "SKY_AUTH_TOKEN_SECRET" secret)
                |> Task.andThen (\_ -> Schema.migrate db)
                |> Task.andThen (\_ -> Seed.syncFromDisk ())
                |> Task.run
    in
        case result of

            Ok _ ->
                let
                    _ = println "[BOOT] sky-lang.org ready"
                in
                    ()

            Err e ->
                let
                    _ =
                        println
                            ("[FATAL] bootstrap failed: " ++ Error.toString e)
                in
                    System.exit 1


-- ─── api routes (Live.api — outside the TEA cycle) ─────────────────
apiRoutes : List any
apiRoutes =
    [ App.api "GET /admin/login" GhAuth.handleLogin
    , App.api "GET /admin/auth/callback" GhAuth.handleCallback
    , App.api "GET /admin/logout" GhAuth.handleLogout
    -- Dev-mode-only backdoor. Returns 404 unless SKYLANG_DEV_MODE=1.
    -- Mints an admin session for the first SKYLANG_ADMIN_GITHUB_LOGINS
    -- entry so admin views can be tested without an OAuth round-trip.
    , App.api "GET /admin/dev-login" DevLogin.handleDevLogin
    -- Console gate: GitHub-admin session is verified app-side, then
    -- the handler mints a 10-min HS256 JWT (signed with
    -- SKY_CONSOLE_TOKEN_SECRET) and redirects to /_sky/console?token=…
    -- so the framework's auth layer flips it into a 4-hour cookie.
    , App.api "GET /admin/console-link" ConsoleAuth.handleConsoleLink
    , App.api "GET /healthz" handleHealthz
    , App.api "GET /robots.txt" handleRobots
    , App.api "GET /sitemap.xml" handleSitemap
    ]


handleHealthz _req =
    Task.succeed (Resp.plain 200 "text/plain" "ok")


handleRobots _req =
    Task.succeed
        (Resp.plain
            200
            "text/plain"
            "User-agent: *\nAllow: /\n\nSitemap: https://sky-lang.org/sitemap.xml\n")


handleSitemap _req =
    let
        baseUrl = System.getenvOr "SKYLANG_BASE_URL" "https://sky-lang.org"
        urls = [ "/", "/blog" ]
        body =
            "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n"
                ++ "<urlset xmlns=\"http://www.sitemaps.org/schemas/sitemap/0.9\">\n"
                ++ joinUrls baseUrl urls
                ++ "</urlset>\n"
    in
        Task.succeed (Resp.plain 200 "application/xml; charset=utf-8" body)


joinUrls : String -> List String -> String
joinUrls base urls =
    case urls of

        [] ->
            ""

        u :: rest ->
            "  <url><loc>" ++ base ++ u ++ "</loc></url>\n"
                ++ joinUrls base rest


-- ─── Entry ────────────────────────────────────────────────────────
app =
    App.app
        { init = init
        , update = update
        , view = view
        , subscriptions = subscriptions
        }
        |> App.withRoutes (Routes.routes ++ apiRoutes)
        |> App.withNotFound Routes.notFound
        |> App.withRequest ModelRequest.applyRequest
        |> App.withConfig
               (WebConfig
                   { App.webDefaults | port = 8000
                   , inputMode = Just "debounce"
                   })
        |> App.withHead Seo.headFor


main =
    let
        _ = bootstrap
    in
        App.run app


config : Config.Config
config =
    Config.default |> Config.withLog Text Info
        |> Config.withSessions SharedWithDatabase
