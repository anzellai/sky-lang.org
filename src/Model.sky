module Model exposing (init)

-- | Initial model + per-request setup.
--
-- `init` runs on every fresh Sky.Live session load. Sky.Live's `init`
-- req exposes only `path` + `query` — NO cookies, NO headers (filed
-- as Sky compiler task #423).
--
-- We work around this exactly the way SkyDeploy's control-plane does:
-- the sign-in handler (Auth.Github.completeSignIn OR Auth.DevLogin)
-- INSERTs a one-time token into `sso_logins` and redirects to
-- /admin?sso=<token> AFTER clearing sky_sid so Sky.Live mints a
-- brand-new session. Init reads ?sso= from the query, calls
-- SsoLogins.consume (one-shot SELECT + DELETE), and stuffs the
-- result into Model.session.
--
-- Reference: SkyDeploy `control-plane/src/SsoApp.sky`
-- sessionFromQuery + Store.consumeSsoLogin.

import Sky.Core.Prelude exposing (..)
import Std.Cmd as Cmd
import Std.Db as Db
import State exposing (..)
import Db.Conn exposing (db)
import Db.Posts as Posts


-- `init` is PURE (Sky.Spa split requirement): it constructs the
-- starting model + a DEFERRED, curated GET-safe read
-- (`Cmd.perform (Db.query …) GotPosts`). The SSR handler settles that
-- read server-side so the first paint carries the real published-post
-- list a crawler sees (design §4.2, `SSR_GET_SAFE_KERNELS`), and the
-- wasm client re-issues the same read as an RPC after boot. No
-- synchronous `Task.run` here — that would taint `init` and force the
-- whole module backend-only, which the split refuses to leak into the
-- client tree.
--
-- The `?sso=<token>` session pickup moved to `Model.Request.applyRequest`
-- (the `App.withRequest` hook), which stays server-only.
init : any -> ( Model, Cmd Msg )
init _ =
    ( { page = HomePage
      , session = Nothing
      , posts = []
      , currentPost = Nothing
      , flash = emptyFlash
      , editorTitle = ""
      , editorSlug = ""
      , editorSummary = ""
      , editorBody = ""
      , editorMode = "new"
      }
    , Cmd.perform (Db.query db Posts.publishedSql []) GotPosts
    )
