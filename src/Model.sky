module Model exposing (init, applyRequest)

-- | Initial model + per-request setup.
--
-- `init` runs on every fresh Sky.Live session load. Sky.Live's `init`
-- req exposes only `path` + `query` — NO cookies, NO headers (filed
-- as Sky compiler task #423).
--
-- We work around this exactly the way SkyDeploy's control-plane does:
-- the sign-in handler (Auth.Github.completeSignIn OR Auth.DevLogin)
-- INSERTs a one-time token into `sso_logins` and redirects to
-- /admin?sso=<token> AFTER clearing sky_sid so Sky.Live mints a
-- brand-new session. Init reads ?sso= from the query, calls
-- SsoLogins.consume (one-shot SELECT + DELETE), and stuffs the
-- result into Model.session.
--
-- Reference: SkyDeploy `control-plane/src/SsoApp.sky`
-- sessionFromQuery + Store.consumeSsoLogin.
import Sky.Core.Prelude exposing (..)
import Sky.Core.Dict as Dict
import Sky.Core.Maybe as Maybe
import Sky.Core.Result as Result
import Sky.Core.Task as Task
import Sky.Core.Time as Time
import Sky.Http.Server as Server
import Std.Cmd as Cmd
import State exposing (..)
import Db.Posts as Posts
import Db.SsoLogins as SsoLogins


-- `init` runs on every fresh Sky.Live session. Under Std.App the
-- HTTP request is NOT delivered through `init`'s seed (Std.App fixes
-- the seed to `()` for cross-target portability); it arrives through
-- the `applyRequest` hook below (`App.withRequest`), which runs after
-- `init` but before the first paint. So `init` starts signed-out and
-- `applyRequest` fills in the session.
init : any -> ( Model, Cmd Msg )
init _ =
    let
        posts = Result.withDefault [] (Posts.listPublished ())
    in
        ( { page = HomePage
          , session = Nothing
          , posts = posts
          , currentPost = Nothing
          , flash = emptyFlash
          , editorTitle = ""
          , editorSlug = ""
          , editorSummary = ""
          , editorBody = ""
          , editorMode = "new"
          }
        , Cmd.none
        )


-- | `applyRequest req model` — the Std.App `withRequest` hook. Runs
-- after `init`, before the first render, with the full HTTP request
-- (path/query/cookies). Reads `?sso=<token>` from the parsed query,
-- one-shot-consumes it via `SsoLogins.consume`, and stuffs the
-- resulting session into the model so the authenticated view is
-- correct on first paint. `req.query` is already a parsed
-- `Dict String String` (Std.App runs `Http.parseQuery` for us).
applyRequest : Server.Request -> Model -> ( Model, Cmd Msg )
applyRequest req model =
    let
        token = Maybe.withDefault "" (Dict.get "sso" req.query)
    in
        if token == "" then
            ( model, Cmd.none )

        else
            let
                nowMs = Result.withDefault 0 (Task.run (Time.unixMillis ()))
            in
                ( { model | session = SsoLogins.consume token nowMs }
                , Cmd.none
                )
