module Db.Posts exposing
    ( listPublished
    , listAll
    , getBySlug
    , create
    , update
    , publish
    , unpublish
    , softDelete
    )

-- | Db.Posts — CRUD for the `posts` table.
--
-- Reads return `Result Error _` (synchronous Task.run wrap) so
-- TEA `update` branches can pattern-match directly. Writes are
-- also Result-wrapped — the post-write flow needs the affected
-- count + slug for the redirect, and Result keeps the call sites
-- linear.
--
-- The two list reads stay raw SQL: `listPublished` shares
-- `publishedSql` with the Sky.Spa split's GET-safe init read, and
-- `listAll` orders by COALESCE(published_at, updated_at). Their rows
-- come back as `Dict String String` and `rowToPost` lifts them. The
-- other reads and writes go through `Std.Db.Store`.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Sky.Core.Result as Result
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store exposing (Store)
import Db.Conn exposing (db)
import State exposing (Post, emptyPost, rowToPost, publishedSql)

-- The published-posts SELECT (`publishedSql`) moved to the shared
-- pure `State` module so `Model.init`'s frontend-retained GET-safe
-- read can reference it (this module is server-tainted, routed
-- backend-only by the Sky.Spa split).
-- | One `posts` row (migration 0001 in `Db.Schema`). `published_at`
-- and `deleted_at` are NULL until the post is published or deleted.
type alias PostRow =
    { id : Int
    , slug : String
    , title : String
    , summary : String
    , bodyMd : String
    , bodyHtml : String
    , authorGithubLogin : String
    , publishedAt : Maybe Int
    , createdAt : Int
    , updatedAt : Int
    , deletedAt : Maybe Int
    }


-- | The nullable columns use a `Just 0` witness: a `Nothing` witness
-- carries no kind for `Codec.auto` to derive.
postRowCodec : Codec PostRow
postRowCodec =
    Codec.auto
        { id = 0
        , slug = ""
        , title = ""
        , summary = ""
        , bodyMd = ""
        , bodyHtml = ""
        , authorGithubLogin = ""
        , publishedAt = Just 0
        , createdAt = 0
        , updatedAt = 0
        , deletedAt = Just 0
        }


store : Store PostRow
store =
    Store.fromCodec "posts" postRowCodec |> Store.primaryKey "id"
        |> Store.generated [ "id" ]


-- | A live (not soft-deleted) post with this slug.
liveSlug : String -> Store.Cond
liveSlug slug =
    Store.and_ [ Store.eq "slug" (SqlString slug), Store.isNull "deleted_at" ]


-- | The same values as `rowToPost` gives for the raw reads: an
-- unpublished post has `publishedAt = 0` and `isPublished = False`.
toPost : PostRow -> Post
toPost row =
    { emptyPost
        | id = row.id
        , slug = row.slug
        , title = row.title
        , summary = row.summary
        , bodyMd = row.bodyMd
        , bodyHtml = row.bodyHtml
        , authorGithubLogin = row.authorGithubLogin
        , publishedAt = Maybe.withDefault 0 row.publishedAt
        , createdAt = row.createdAt
        , updatedAt = row.updatedAt
        , isPublished = row.publishedAt /= Nothing
    }


-- | Run a write and drop its row count.
runWrite : Task Error Int -> Result Error ()
runWrite write =
    Task.run write |> Result.map (\_ -> ())


-- ─── Reads ────────────────────────────────────────────────────────
listPublished _ =
    Task.run (Db.query db publishedSql [])
        |> Result.map (\rows -> List.map (\r -> rowToPost r) rows)


listAll _ =
    let
        sql =
            """
            SELECT id, slug, title, summary, body_md, body_html,
                   author_github_login,
                   COALESCE(published_at, 0) AS published_at,
                   created_at, updated_at,
                   CASE WHEN published_at IS NULL THEN 0 ELSE 1 END AS is_published
            FROM posts
            WHERE deleted_at IS NULL
            ORDER BY COALESCE(published_at, updated_at) DESC
            """
    in
        Task.run (Db.query db sql [])
            |> Result.map (\rows -> List.map (\r -> rowToPost r) rows)


getBySlug : String -> Result Error (Maybe Post)
getBySlug slug =
    Store.query store |> Store.where_ (liveSlug slug) |> Store.toMaybe db
        |> Task.run
        |> Result.map (Maybe.map toPost)


-- ─── Writes ───────────────────────────────────────────────────────
-- | `create slug title summary bodyMd bodyHtml authorLogin nowMs`
-- — insert a new draft (published_at left NULL).
create : String -> String -> String -> String -> String -> String -> Int -> Result Error ()
create slug title summary bodyMd bodyHtml authorLogin nowMs =
    runWrite
        (Store.insert
            db
            store
            { id = 0
            , slug = slug
            , title = title
            , summary = summary
            , bodyMd = bodyMd
            , bodyHtml = bodyHtml
            , authorGithubLogin = authorLogin
            , publishedAt = Nothing
            , createdAt = nowMs
            , updatedAt = nowMs
            , deletedAt = Nothing
            })


-- | `update slug title summary bodyMd bodyHtml nowMs` — overwrite
-- the latest body for an existing post (does not touch publish
-- state — use `publish` / `unpublish` for that).
update : String -> String -> String -> String -> String -> Int -> Result Error ()
update slug title summary bodyMd bodyHtml nowMs =
    runWrite
        (Store.updateFields
            db
            store
            (liveSlug slug)
            [ ( "title", SqlString title )
            , ( "summary", SqlString summary )
            , ( "body_md", SqlString bodyMd )
            , ( "body_html", SqlString bodyHtml )
            , ( "updated_at", SqlInt nowMs )
            ])


publish : String -> Int -> Result Error ()
publish slug nowMs =
    runWrite
        (Store.updateFields
            db
            store
            (liveSlug slug)
            [ ( "published_at", SqlInt nowMs ), ( "updated_at", SqlInt nowMs ) ])


unpublish : String -> Int -> Result Error ()
unpublish slug nowMs =
    runWrite
        (Store.updateFields
            db
            store
            (liveSlug slug)
            [ ( "published_at", SqlNull (SqlInt 0) )
            , ( "updated_at", SqlInt nowMs )
            ])


-- | Soft-delete by slug, whether or not the post is already deleted.
softDelete : String -> Int -> Result Error ()
softDelete slug nowMs =
    runWrite
        (Store.updateFields
            db
            store
            (Store.eq "slug" (SqlString slug))
            [ ( "deleted_at", SqlInt nowMs ), ( "updated_at", SqlInt nowMs ) ])

-- Row → typed record lives in `State.rowToPost` now (a PURE lifter
-- shared by the client decode branch + these server helpers).
