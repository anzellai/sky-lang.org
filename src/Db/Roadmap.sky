module Db.Roadmap exposing (listAll)

-- | Db.Roadmap — read-only roadmap surface for v1.
--
-- Full CRUD (with admin write paths) ships in v2 alongside the
-- /roadmap public page. For now this module exists so the
-- schema migration is reachable from `Db.Schema` and the surface
-- is callable from any future read path.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.List as List
import Sky.Core.Maybe as Maybe
import Sky.Core.Result as Result
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Db.Store as Store exposing (Store)
import Db.Conn exposing (db)

type alias RoadmapItem =
    { id : Int
    , title : String
    , bodyMd : String
    , bodyHtml : String
    , status : String
    , ordinal : Int
    , createdAt : Int
    , updatedAt : Int
    , shippedAt : Int
    }

-- | One `roadmap_items` row. `shipped_at` is NULL until the item ships.
type alias RoadmapRow =
    { id : Int
    , title : String
    , bodyMd : String
    , bodyHtml : String
    , status : String
    , ordinal : Int
    , createdAt : Int
    , updatedAt : Int
    , shippedAt : Maybe Int
    }


-- | `shipped_at` uses a `Just 0` witness: a `Nothing` witness carries no
-- kind for `Codec.auto` to derive.
roadmapRowCodec : Codec RoadmapRow
roadmapRowCodec =
    Codec.auto
        { id = 0
        , title = ""
        , bodyMd = ""
        , bodyHtml = ""
        , status = ""
        , ordinal = 0
        , createdAt = 0
        , updatedAt = 0
        , shippedAt = Just 0
        }


-- | The table is created by migration 0005 in `Db.Schema`.
store : Store RoadmapRow
store =
    Store.fromCodec "roadmap_items" roadmapRowCodec |> Store.primaryKey "id"
        |> Store.generated [ "id" ]


listAll : () -> Result Error (List RoadmapItem)
listAll _ =
    Store.query store |> Store.orderAsc "status" |> Store.orderAsc "ordinal"
        |> Store.toList db
        |> Task.run
        |> Result.map (List.map toItem)


-- | An unshipped item reads `shippedAt = 0`, as before.
toItem : RoadmapRow -> RoadmapItem
toItem row =
    { id = row.id
    , title = row.title
    , bodyMd = row.bodyMd
    , bodyHtml = row.bodyHtml
    , status = row.status
    , ordinal = row.ordinal
    , createdAt = row.createdAt
    , updatedAt = row.updatedAt
    , shippedAt = Maybe.withDefault 0 row.shippedAt
    }
