module Db.Sessions exposing (create, findByTokenId, delete, purgeExpired)

-- | Db.Sessions — admin session token storage.
--
-- Sessions are minted on successful OAuth callback (see
-- `Auth.Session`) and looked up on every `/admin/*` request. The
-- token JWT itself carries `tokenId` as a claim; the DB row is
-- the revocation list — deleting a row signs the user out across
-- all browsers/devices regardless of cookie freshness.
--
-- The table is created by migration 0003 in `Db.Schema`; the reads
-- and writes go through `Std.Db.Store` with the codec below.

import Sky.Core.Prelude exposing (..)
import Sky.Core.Error as Error exposing (Error)
import Sky.Core.Maybe as Maybe
import Sky.Core.Result as Result
import Sky.Core.Task as Task
import Std.Codec as Codec exposing (Codec)
import Std.Db as Db exposing (SqlValue(..))
import Std.Db.Store as Store exposing (Store)
import Db.Conn exposing (db)
import State exposing (Session, emptySession)

-- | One `admin_sessions` row. Every column is NOT NULL.
type alias SessionRow =
    { tokenId : String
    , githubLogin : String
    , githubId : Int
    , createdAt : Int
    , expiresAt : Int
    }


sessionRowCodec : Codec SessionRow
sessionRowCodec =
    Codec.auto
        { tokenId = ""
        , githubLogin = ""
        , githubId = 0
        , createdAt = 0
        , expiresAt = 0
        }


store : Store SessionRow
store =
    Store.fromCodec "admin_sessions" sessionRowCodec
        |> Store.primaryKey "token_id"


create : String -> String -> Int -> Int -> Int -> Result Error ()
create tokenId githubLogin githubId nowMs expiresMs =
    Store.insert
        db
        store
        { tokenId = tokenId
        , githubLogin = githubLogin
        , githubId = githubId
        , createdAt = nowMs
        , expiresAt = expiresMs
        }
        |> Task.run
        |> Result.map (\_ -> ())


findByTokenId : String -> Int -> Result Error (Maybe Session)
findByTokenId tokenId nowMs =
    Store.query store
        |> Store.where_
               (Store.and_
                   [ Store.eq "token_id" (SqlString tokenId)
                   , Store.gt "expires_at" (SqlInt nowMs)
                   ])
        |> Store.toMaybe db
        |> Task.run
        |> Result.map (Maybe.map toSession)


delete : String -> Result Error ()
delete tokenId =
    Store.delete db store "token_id" tokenId |> Task.run
        |> Result.map (\_ -> ())


purgeExpired : Int -> Result Error ()
purgeExpired nowMs =
    Store.deleteWhere db store (Store.lte "expires_at" (SqlInt nowMs))
        |> Task.run
        |> Result.map (\_ -> ())


-- ─── Row → typed record ───────────────────────────────────────────
toSession : SessionRow -> Session
toSession row =
    { emptySession
        | tokenId = row.tokenId
        , githubLogin = row.githubLogin
        , githubId = row.githubId
        , expiresAt = row.expiresAt
    }
