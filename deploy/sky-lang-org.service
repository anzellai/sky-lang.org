[Unit]
Description=sky-lang.org (Sky.Live app)
After=network.target
Wants=network.target

[Service]
Type=simple
# Embedded PostgreSQL refuses to run as root (initdb/postgres reject
# uid 0), so the service runs as the dedicated `skylang` user.
# setup-remote.sh creates it and chowns /opt/sky-lang-org +
# /var/lib/sky-lang-org to it.
User=skylang
Group=skylang
WorkingDirectory=/opt/sky-lang-org
EnvironmentFile=/opt/sky-lang-org/.env
# --embed triggers the runtime to provision + manage its own PostgreSQL
# cluster (under SKY_DATA_DIR, via SKY_POSTGRES_BIN). Without the flag the
# app expects an external DSN (SKY_DB_PATH / DATABASE_URL) and exits.
ExecStart=/opt/sky-lang-org/app --embed
Restart=on-failure
RestartSec=5s
KillSignal=SIGINT
TimeoutStopSec=10s

# Memory caps sized for the e2-small VM (2 GiB). The app auto-derives
# GOMEMLIMIT (~995 MiB here) from detected RAM, so the cgroup cap MUST sit
# comfortably above it — a cap below GOMEMLIMIT gets the process cgroup-OOM
# -killed under load before its own GC can react (the failure this replaced:
# an e2-micro-era 500M drop-in vs a 995M GOMEMLIMIT). MemoryMax leaves ~475
# MiB for Caddy + embedded-PostgreSQL non-heap + the OS; MemoryHigh throttles
# (reclaim) before the hard kill. Resize the VM ⇒ revisit these two numbers.
MemoryHigh=1300M
MemoryMax=1500M
TasksMax=512

# Hardening
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/sky-lang-org /opt/sky-lang-org
ProtectHome=true

# Run as a dedicated user (created by setup-remote.sh on first run
# if it doesn't exist — or use a real OS-Login user if you prefer).
# Defaults to root for simplicity; lock down via your own User= line
# once you have a service account set up.
# User=sky-lang-org
# Group=sky-lang-org

StandardOutput=journal
StandardError=journal
SyslogIdentifier=sky-lang-org

[Install]
WantedBy=multi-user.target
