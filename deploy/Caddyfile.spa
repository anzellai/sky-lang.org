# Caddy reverse proxy for sky-lang.org — Sky.Spa (SSR) variant.
#
# Identical topology to the Sky.Live Caddyfile (Cloudflare orange-cloud,
# end-to-end HTTPS with a CF Origin cert), differing only in where the
# static roots live: the Sky.Spa split ships brand/ + the wasm client
# under /opt/sky-lang-org-spa/frontend/dist, and the SSR/RPC backend is
# reverse-proxied on :8000 exactly as the Live app was.
#
# Cert pair lives at:
#   /etc/caddy/certs/sky-lang.org.crt
#   /etc/caddy/certs/sky-lang.org.key
# Generated once via the CF dashboard (SSL/TLS → Origin Server →
# Create Certificate). Cloudflare's SSL/TLS mode must be "Full (strict)".

# :80 — Cloudflare may still hit us on plain HTTP for cache-warming
# or non-proxied health checks. Redirect everything to :443 except
# Caddy's own healthz so deploy/restart blips don't break LB checks.
:80 {
    handle /healthz {
        respond "ok" 200
    }
    handle {
        redir https://{host}{uri} 308
    }
}


:443 {
    tls /etc/caddy/certs/sky-lang.org.crt /etc/caddy/certs/sky-lang.org.key

    # Health check terminates at Caddy so deploy/restart blips don't
    # poison the load balancer.
    handle /healthz {
        respond "ok" 200
    }

    # brand/ assets — the Sky.Spa compiler copies the declared static dir
    # (WebConfig static="brand", staticUrl="/brand") INTO the frontend
    # bundle, so they live under frontend/dist/brand. Caddy serves them
    # directly with immutable cache headers; the backend also serves them
    # same-origin, but the short-circuit avoids an app round-trip.
    handle /brand/* {
        root * /opt/sky-lang-org-spa/frontend/dist
        file_server
        header Cache-Control "public, max-age=86400, immutable"
    }

    # Reverse-proxy everything else (SSR pages, the wasm client + wasm_exec.js
    # served by Server.static "/", and /_rpc/* + api routes) to the split
    # backend on :8000. On origin failure fall through to the static-fallback
    # index.html.
    handle {
        reverse_proxy localhost:8000 {
            transport http {
                read_timeout 30s
                write_timeout 30s
            }
            @app_down status 5xx
            handle_response @app_down {
                root * /opt/sky-lang-org-spa/static-fallback
                rewrite * /index.html
                file_server
            }
        }
    }

    encode gzip zstd
    log {
        output stderr
        format console
    }
}
